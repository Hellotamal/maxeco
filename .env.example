# Environment configuration template for MaxEco Business Operating System
# NOTE: Do NOT put real secrets in version control. Copy to .env for local adjustments.

# Business Operating Identity
VITE_COMPANY_NAME="MaxEco Energy & Tech"
VITE_COMPANY_LOCATION="Guwahati, Assam, India"
VITE_CONTACT_PHONE="+91 98765 43210"
VITE_CONTACT_EMAIL="contact@maxeco.in"
VITE_WHATSAPP_NUMBER="919876543210"

# Default Currency & Region
VITE_CURRENCY_SYMBOL="₹"
VITE_CURRENCY_CODE="INR"
VITE_REGION_TIMEZONE="Asia/Kolkata"

# Default Solar Tariff & Sizing Factors (APDCL / Assam Benchmarks)
VITE_SOLAR_TARIFF_COMMERCIAL=7.85
VITE_SOLAR_TARIFF_DOMESTIC=6.20
VITE_SOLAR_GEN_FACTOR_NER=120.0

# Form Delivery Integration (Optional - leave blank for direct WhatsApp / mailto fallback)
# Set your verified endpoint URL from Formspree, Web3Forms, or custom API gateway
VITE_CONTACT_FORM_ENDPOINT=""

# Security Gate
# Private local authentication passkey for offline admin workstation (set locally in .env only; NEVER commit)
VITE_ADMIN_DEFAULT_PIN=""

